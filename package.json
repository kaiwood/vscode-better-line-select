{
  "name": "better-line-select",
  "displayName": "Better Line Select",
  "description": "Line selection on steroids",
  "version": "2.0.0",
  "publisher": "kaiwood",
  "icon": "assets/icon.png",
  "license": "MIT",
  "bugs": "https://github.com/kaiwood/vscode-better-line-select/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiwood/vscode-better-line-select"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension",
  "contributes": {
    "commands": [
      {
        "command": "better-line-select.downward",
        "title": "Select Line (downward)"
      },
      {
        "command": "better-line-select.upward",
        "title": "Select Line (upward)"
      }
    ],
    "keybindings": [
      {
        "command": "better-line-select.downward",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "better-line-select.upward",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "16.18.126",
    "@types/vscode": "1.74.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "9.39.4",
    "mocha": "11.3.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
